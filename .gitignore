# --- 构建缓存 ---
*.o
*.lo
*.so
*.a
.luarc.json

# --- 编辑器 / 系统 ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
.venv/

# --- 本地构建工作区（不入库） ---
/sdk/
/luci-src/
/build_dir/
/staging_dir/
/bin/
/tmp/
/dl/
/logs/

# --- 注意 ---
# chfs/bin/<arch>/chfs 是刻意入库的预置二进制，用于云编译时免去实时下载。
# 上面的 /bin/ 只匹配仓库根目录下的 bin/，不会影响 chfs/bin/。
